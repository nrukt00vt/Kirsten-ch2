}
ll
}
# Responsibilities (no genetics): softmax(η)
compute_resp_on_fused <- function(beta_vec, ptrav, fused, logI_ns, sink_j) {
b <- unpack_beta(beta_vec); N <- nrow(fused); J <- ncol(fused)
log_terms <- matrix(NA_real_, N, J)
for (n in 1:N) {
eta <- b$beta_M*fused[n,] + b$beta_I*logI_ns[n,] + b$beta_T*ptrav[n,]
eta[sink_j[n]] <- eta[sink_j[n]] + b$beta_loc
log_terms[n,] <- eta
}
row_softmax_log(log_terms)
}
## ==========================================================
## 3) EM fitting (optimize beta, zeta, and u; no w here)
## ==========================================================
beta <- pack_beta(0, 0, 0.5, 0.2)
zeta <- pack_zeta(-1.5, 0.5, 0.5, qlogis(0.7), qlogis(0.85))
u <- rep(0, K)  # α starts uniform
max_iter <- 120; tol <- 1e-4
history <- data.frame(iter=integer(), tot_ll=double(), trav_ll=double(),
a1=double(), a2=double(), a3=double())
for (iter in 1:max_iter) {
fused <- fused_ns_from_u(u, logMk_ns)
# E: latent travel propensity and implied report prob
zU <- unpack_zeta(zeta)
ptrav <- sigmoid( zU$z0 + zU$zM*fused + zU$zI*logI_ns )
qrep  <- zU$Se * ptrav + (1 - zU$Sp) * (1 - ptrav)
qrep  <- pmin(pmax(qrep, 1e-8), 1-1e-8)
# E: responsibilities over sources (no genetics)
r <- compute_resp_on_fused(beta, ptrav, fused, logI_ns, sink_j)
# M1: update gating beta
beta_new <- optim(beta, gating_obj_on_fused, rmat=r, ptrav=ptrav,
fused=fused, logI_ns=logI_ns, sink_j=sink_j,
control=list(fnscale=-1, maxit=500))$par
# M2: update zeta from travel history
zeta_new <- optim(zeta, travel_obj_on_fused, H=H, fused=fused, logI_ns=logI_ns,
control=list(fnscale=-1, maxit=500))$par
# M3: update u (layer mixture) — maximize total objective wrt u
obj_u <- function(u_try) {
fused_try <- fused_ns_from_u(u_try, logMk_ns)
ptrav_try <- sigmoid(unpack_zeta(zeta_new)$z0 +
unpack_zeta(zeta_new)$zM*fused_try +
unpack_zeta(zeta_new)$zI*logI_ns)
-( loglik_on_fused(beta_new, ptrav_try, fused_try, logI_ns, sink_j) +
travel_obj_on_fused(zeta_new, H, fused_try, logI_ns) ) +
1e-3 * sum(u_try^2)   # tiny L2 on u for stability
}
u_new <- optim(u, obj_u, control=list(maxit=400))$par
# Monitor
fused_new <- fused_ns_from_u(u_new, logMk_ns)
ptrav_new <- sigmoid(unpack_zeta(zeta_new)$z0 +
unpack_zeta(zeta_new)$zM*fused_new +
unpack_zeta(zeta_new)$zI*logI_ns)
tot_ll <- loglik_on_fused(beta_new, ptrav_new, fused_new, logI_ns, sink_j) +
travel_obj_on_fused(zeta_new, H, fused_new, logI_ns)
trav_ll <- travel_obj_on_fused(zeta_new, H, fused_new, logI_ns)
a_now <- softmax(u_new)
history <- rbind(history, data.frame(iter=iter, tot_ll=tot_ll, trav_ll=trav_ll,
a1=a_now[1], a2=a_now[2], a3=a_now[3]))
delta <- max(abs(c(beta_new - beta, zeta_new - zeta, u_new - u)))
beta <- beta_new; zeta <- zeta_new; u <- u_new
if (delta < tol) break
}
cat("Converged in", nrow(history), "iterations\n")
print(tail(history, 5))
alpha_hat <- softmax(u); names(alpha_hat) <- paste0("layer", 1:K)
cat("\nEstimated layer mixture (alpha):\n"); print(round(alpha_hat, 3))
## ==========================================================
## 4) Post-fit responsibilities, flows, connectivity
## ==========================================================
fused_hat <- fused_ns_from_u(u, logMk_ns)
z_hat <- unpack_zeta(zeta)
p_hat <- sigmoid( z_hat$z0 + z_hat$zM*fused_hat + z_hat$zI*logI_ns )
r_hat <- compute_resp_on_fused(beta, p_hat, fused_hat, logI_ns, sink_j)
F <- matrix(0, J, J)   # effective flows: F[i, j] = sum_n r_hat[n,i] for cases with sink j
for (n in 1:N) for (i in 1:J) F[i, sink_j[n]] <- F[i, sink_j[n]] + r_hat[n,i]
colnames(F) <- paste0("sink_", 1:J); rownames(F) <- paste0("src_", 1:J)
C <- sweep(F, 2, colSums(F), "/")  # column-normalized connectivity
cat("\nParameters:\n")
print(list(beta = unpack_beta(beta),
zeta = list(z0=z_hat$z0, zM=z_hat$zM, zI=z_hat$zI, Se=z_hat$Se, Sp=z_hat$Sp),
alpha = alpha_hat))
cat("\nFlow matrix F (src -> sink):\n"); print(round(F, 1))
cat("\nConnectivity index C (column-normalized):\n"); print(round(C, 3))
# (Optional) quick heatmaps
heat <- function(MAT, title="") {
op <- par(mar=c(4,4,2,1))
image(t(MAT[nrow(MAT):1, ]), axes=FALSE, col=terrain.colors(64), main=title)
axis(1, at=seq(0,1,length.out=ncol(MAT)), labels=colnames(MAT), las=2)
axis(2, at=seq(0,1,length.out=nrow(MAT)), labels=rev(rownames(MAT)), las=2)
box(); par(op)
}
heat(F, "Effective flows F (src->sink)")
heat(C, "Connectivity index C")
