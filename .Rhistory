if (Z == 1) H[n,i] <- rbinom(1, 1, Se_true) else H[n,i] <- rbinom(1, 1, 1-(1-Sp_true))
}
}
# Incidence features per case-source
logI_ns <- logInc_by_source[sink_j, ]
pack_beta <- function(beta_M, beta_I, beta_T, beta_loc) c(beta_M, beta_I, beta_T, beta_loc)
unpack_beta <- function(b) list(beta_M=b[1], beta_I=b[2], beta_T=b[3], beta_loc=b[4])
pack_zeta <- function(z0, zM, zI, se_logit, sp_logit) c(z0, zM, zI, se_logit, sp_logit)
unpack_zeta <- function(z) list(z0=z[1], zM=z[2], zI=z[3],
Se=sigmoid(z[4]), Sp=sigmoid(z[5]))
# Fused NxJ matrix from logits u and layer matrices logMk_ns (list)
fused_ns_from_u <- function(u, logMk_ns) {
alpha <- softmax(u)
Reduce(`+`, Map(function(a, X) a * X, alpha, logMk_ns))
}
# Objectives now take 'fused' instead of single-layer logM_ns
gating_obj_on_fused <- function(bvec, rmat, ptrav, fused, logI_ns, sink_j) {
b <- unpack_beta(bvec); N <- nrow(rmat)
val <- 0
for (n in 1:N) {
eta <- b$beta_M*fused[n,] + b$beta_I*logI_ns[n,] + b$beta_T*ptrav[n,]
eta[sink_j[n]] <- eta[sink_j[n]] + b$beta_loc
val <- val + sum(rmat[n,]*eta) - logsumexp(eta)
}
val - 0.001*sum(bvec^2)  # small ridge
}
travel_obj_on_fused <- function(zvec, H, fused, logI_ns) {
z <- unpack_zeta(zvec)
p <- sigmoid( z$z0 + z$zM*fused + z$zI*logI_ns )          # latent travel propensity
q <- z$Se * p + (1 - z$Sp) * (1 - p)                      # P(H=1) after Se/Sp
q <- pmin(pmax(q, 1e-8), 1-1e-8)
sum(H*log(q) + (1-H)*log(1-q)) - 0.001*sum(zvec[1:3]^2)   # ridge on zetas only
}
mixture_loglik_on_fused <- function(beta_vec, ptrav, w, logLgen, fused, logI_ns, sink_j) {
b <- unpack_beta(beta_vec); N <- nrow(fused); ll <- 0
for (n in 1:N) {
eta <- b$beta_M*fused[n,] + b$beta_I*logI_ns[n,] + b$beta_T*ptrav[n,]
eta[sink_j[n]] <- eta[sink_j[n]] + b$beta_loc
log_terms <- eta + w*logLgen[n,]
ll <- ll + logsumexp(log_terms)
}
ll
}
compute_resp_on_fused <- function(beta_vec, ptrav, w, logLgen, fused, logI_ns, sink_j) {
b <- unpack_beta(beta_vec); N <- nrow(fused); J <- ncol(fused)
log_terms <- matrix(NA_real_, N, J)
for (n in 1:N) {
eta <- b$beta_M*fused[n,] + b$beta_I*logI_ns[n,] + b$beta_T*ptrav[n,]
eta[sink_j[n]] <- eta[sink_j[n]] + b$beta_loc
log_terms[n,] <- eta + w*logLgen[n,]
}
row_softmax_log(log_terms)
}
## ==========================================================
## 3) EM fitting (now also optimizes u, the mixture logits)
## ==========================================================
# Inits
beta <- pack_beta(0, 0, 0.5, 0.2)
zeta <- pack_zeta(-1.5, 0.5, 0.5, qlogis(0.7), qlogis(0.85))
w <- 1.0
u <- rep(0, K)   # equal alphas initially (softmax(0,...,0) = 1/K)
max_iter <- 120; tol <- 1e-4
history <- data.frame(iter=integer(), mix_ll=double(), trav_ll=double(), w=double(),
a1=double(), a2=double(), a3=double())
for (iter in 1:max_iter) {
# Fuse layers with current u (global mixture)
fused <- fused_ns_from_u(u, logMk_ns)
# E: travel propensity & reported-probabilities
z <- unpack_zeta(zeta)
ptrav <- sigmoid( z$z0 + z$zM*fused + z$zI*logI_ns )
qrep  <- z$Se * ptrav + (1 - z$Sp) * (1 - ptrav)
qrep  <- pmin(pmax(qrep, 1e-8), 1-1e-8)
# E: responsibilities over sources
r <- compute_resp_on_fused(beta, ptrav, w, logLgen, fused, logI_ns, sink_j)
# M1: update beta on fused
beta_new <- optim(beta, gating_obj_on_fused, rmat=r, ptrav=ptrav,
fused=fused, logI_ns=logI_ns, sink_j=sink_j,
control=list(fnscale=-1, maxit=500))$par
# M2: update zeta on fused
zeta_new <- optim(zeta, travel_obj_on_fused, H=H, fused=fused, logI_ns=logI_ns,
control=list(fnscale=-1, maxit=500))$par
# M3a: update genetics weight w (1-D)
obj_w <- function(w_try) {
- mixture_loglik_on_fused(beta_new,
ptrav=sigmoid(unpack_zeta(zeta_new)$z0 +
unpack_zeta(zeta_new)$zM*fused +
unpack_zeta(zeta_new)$zI*logI_ns),
w=w_try, logLgen=logLgen, fused=fused,
logI_ns=logI_ns, sink_j=sink_j) +
0.5*(w_try - 1)^2
}
w_new <- optimize(obj_w, interval=c(0.2, 3.0))$minimum
# M3b: update mixture logits u (thus alphas)
obj_u <- function(u_try) {
fused_try <- fused_ns_from_u(u_try, logMk_ns)
# negative (mixture LL + travel LL) + tiny L2 on u (stability)
- mixture_loglik_on_fused(beta_new,
ptrav=sigmoid(unpack_zeta(zeta_new)$z0 +
unpack_zeta(zeta_new)$zM*fused_try +
unpack_zeta(zeta_new)$zI*logI_ns),
w=w_new, logLgen=logLgen, fused=fused_try,
logI_ns=logI_ns, sink_j=sink_j)
- travel_obj_on_fused(zeta_new, H, fused_try, logI_ns) + 1e-3 * sum(u_try^2)
}
u_new <- optim(u, obj_u, control=list(maxit=400))$par
# Monitor
fused_new <- fused_ns_from_u(u_new, logMk_ns)
mix_ll <- mixture_loglik_on_fused(beta_new,
ptrav=sigmoid(unpack_zeta(zeta_new)$z0 +
unpack_zeta(zeta_new)$zM*fused_new +
unpack_zeta(zeta_new)$zI*logI_ns),
w=w_new, logLgen=logLgen, fused=fused_new,
logI_ns=logI_ns, sink_j=sink_j)
trav_ll <- travel_obj_on_fused(zeta_new, H, fused_new, logI_ns)
alpha_now <- softmax(u_new)
history <- rbind(history, data.frame(iter=iter, mix_ll=mix_ll, trav_ll=trav_ll, w=w_new,
a1=alpha_now[1], a2=alpha_now[2], a3=alpha_now[3]))
# Convergence & accept
delta <- max(abs(c(beta_new - beta, zeta_new - zeta, w_new - w, u_new - u)))
beta <- beta_new; zeta <- zeta_new; w <- w_new; u <- u_new
if (delta < tol) break
}
cat("Converged in", nrow(history), "iterations\n")
print(tail(history, 5))
alpha_hat <- softmax(u)
names(alpha_hat) <- paste0("layer", 1:K)
cat("\nEstimated layer mixture (alpha):\n"); print(round(alpha_hat, 3))
## ==========================================================
## 4) Post-fit responsibilities, flows, connectivity
## ==========================================================
fused_hat <- fused_ns_from_u(u, logMk_ns)
z_hat <- unpack_zeta(zeta)
p_hat <- sigmoid( z_hat$z0 + z_hat$zM*fused_hat + z_hat$zI*logI_ns )
r_hat <- compute_resp_on_fused(beta, p_hat, w, logLgen, fused_hat, logI_ns, sink_j)
F <- matrix(0, J, J)   # F[i, j] = flow from source i to sink j
for (n in 1:N) for (i in 1:J) F[i, sink_j[n]] <- F[i, sink_j[n]] + r_hat[n,i]
colnames(F) <- paste0("sink_", 1:J); rownames(F) <- paste0("src_", 1:J)
C <- sweep(F, 2, colSums(F), "/")  # column-normalized connectivity
cat("\n--- Learned parameters ---\n")
print(list(beta = unpack_beta(beta),
zeta = list(z0=z_hat$z0, zM=z_hat$zM, zI=z_hat$zI, Se=z_hat$Se, Sp=z_hat$Sp),
w = w))
cat("\nFlow matrix F (src -> sink):\n"); print(round(F, 1))
cat("\nConnectivity index C (column-normalized):\n"); print(round(C, 3))
# Optional tiny heatmaps
heat <- function(MAT, title="") {
op <- par(mar=c(4,4,2,1))
image(t(MAT[nrow(MAT):1, ]), axes=FALSE, col=terrain.colors(64), main=title)
axis(1, at=seq(0,1,length.out=ncol(MAT)), labels=colnames(MAT), las=2)
axis(2, at=seq(0,1,length.out=nrow(MAT)), labels=rev(rownames(MAT)), las=2)
box(); par(op)
}
heat(F, "Effective flows F (src->sink)")
heat(C, "Connectivity index C")
M1
image(M!)
image(M1)
image(M2)
image(M3)
M3 <- (distmat <= thr) * outer(pop, pop) / (distmat^1.2); diag(M3) <- 0
# Log & standardize (z-score) each layer for comparability
logM1 <- zscore_offdiag(log(pmax(M1, 1e-10)))
logM2 <- zscore_offdiag(log(pmax(M2, 1e-10)))
logM3 <- zscore_offdiag(log(pmax(M3, 1e-10)))
logMks <- list(logM1, logM2, logM3)
K <- length(logMks)
image(logM3)
image(logM2)
image(logM1)
# Build case sinks
sink_j <- sample(1:J, N, replace = TRUE, prob = pop/sum(pop))
# Convenience: case-source matrices per layer: X_k[n,i] = logM_k[i, sink_j[n]]
logMk_ns <- lapply(logMks, function(Mk){
out <- matrix(NA_real_, N, J)
for (n in 1:N) out[n, ] <- Mk[, sink_j[n]]
out
})
## ----- True data generating process (unknown to the fitter) -----
# True mixture weights (the thing we want to LEARN): alpha_true
u_true <- c(0.6, -0.1, -0.3)                # logits; softmax -> ~percentages
alpha_true <- softmax(u_true)
alpha_true
# Fused logM used to simulate
fused_true_ns <- Reduce(`+`, Map(function(a, X) a*X, alpha_true, logMk_ns))
# Travel propensity (latent Z) uses fused network + incidence
zeta0_t <- -2.2; zetaM_t <- 0.9; zetaI_t <- 0.8
p_travel_true <- sigmoid(zeta0_t + zetaM_t*fused_true_ns + zetaI_t*logInc_by_source[sink_j,])
# Source choice (gating) uses fused + incidence + travel + local bias
betaM_t <- 0.8; betaI_t <- 1.0; betaT_t <- 2.0; betaLoc_t <- 0.8
eta_true <- betaM_t*fused_true_ns + betaI_t*logInc_by_source[sink_j,] + betaT_t*p_travel_true
for (n in 1:N) eta_true[n, sink_j[n]] <- eta_true[n, sink_j[n]] + betaLoc_t
r_true <- row_softmax_log(eta_true)
true_src <- apply(r_true, 1, function(p) sample(1:J, 1, prob = p))
# Genetics: higher log-lik for the true source
mu_hi <-  2.0; sd_hi <- 0.5
mu_lo <- -2.0; sd_lo <- 0.7
logLgen <- matrix(NA_real_, N, J)
for (n in 1:N) for (i in 1:J)
logLgen[n,i] <- if (i == true_src[n]) rnorm(1, mu_hi, sd_hi) else rnorm(1, mu_lo, sd_lo)
# Reported travel with misclassification (Se, Sp)
Se_true <- 0.75; Sp_true <- 0.85
H <- matrix(0L, N, J)
for (n in 1:N) {
for (i in 1:J) {
Z <- rbinom(1, 1, p_travel_true[n,i])
if (Z == 1) H[n,i] <- rbinom(1, 1, Se_true) else H[n,i] <- rbinom(1, 1, 1-(1-Sp_true))
}
}
# Incidence features per case-source
logI_ns <- logInc_by_source[sink_j, ]
pack_beta <- function(beta_M, beta_I, beta_T, beta_loc) c(beta_M, beta_I, beta_T, beta_loc)
# KL divergence between two N×J responsibility matrices
KL <- function(P, Q) {
P <- pmax(P, 1e-12); Q <- pmax(Q, 1e-12)
mean(rowSums(P * log(P / Q)))
}
# Profile the genetics weight w while holding other params fixed
profile_w <- function(w_grid, beta, zeta, u, logMk_ns, logI_ns, logLgen, sink_j) {
fused <- fused_ns_from_u(u, logMk_ns)
ptrav <- sigmoid(unpack_zeta(zeta)$z0 +
unpack_zeta(zeta)$zM * fused +
unpack_zeta(zeta)$zI * logI_ns)
mix_ll <- numeric(length(w_grid))
for (k in seq_along(w_grid)) {
mix_ll[k] <- mixture_loglik_on_fused(beta_vec = beta, ptrav = ptrav,
w = w_grid[k], logLgen = logLgen,
fused = fused, logI_ns = logI_ns, sink_j = sink_j)
}
data.frame(w = w_grid, mix_ll = mix_ll)
}
# Main one-shot report
importance_report <- function(beta, zeta, w, u,
logMk_ns, logI_ns, logLgen, sink_j, H,
w_grid = seq(0, 2.5, length.out = 30)) {
# Fused network and p_travel under the fitted model
fused <- fused_ns_from_u(u, logMk_ns)
zU <- unpack_zeta(zeta)
ptrav <- sigmoid(zU$z0 + zU$zM * fused + zU$zI * logI_ns)
# Responsibilities under the FULL model
r_full <- compute_resp_on_fused(beta, ptrav, w, logLgen, fused, logI_ns, sink_j)
# ---- Ablation 1: No genetics (w = 0) ----
r_nogen <- compute_resp_on_fused(beta, ptrav, 0, logLgen, fused, logI_ns, sink_j)
mix_ll_full <- mixture_loglik_on_fused(beta, ptrav, w, logLgen, fused, logI_ns, sink_j)
mix_ll_nogen <- mixture_loglik_on_fused(beta, ptrav, 0, logLgen, fused, logI_ns, sink_j)
KL_nogen_vs_full <- KL(r_nogen, r_full)
# ---- Ablation 2: No connectivity (β_M = 0, ζ_M = 0) ----
b <- unpack_beta(beta)
b$beta_M <- 0
beta_nonet <- pack_beta(b$beta_M, b$beta_I, b$beta_T, b$beta_loc)
z_vec <- c(zU$z0, 0, zU$zI, qlogis(zU$Se), qlogis(zU$Sp)) # zero the zeta_M coefficient
# recompute p_travel without fused effect
zU_nonet <- unpack_zeta(z_vec)
ptrav_nonet <- sigmoid(zU_nonet$z0 + 0 * fused + zU_nonet$zI * logI_ns)
r_nonet <- compute_resp_on_fused(beta_nonet, ptrav_nonet, w, logLgen, fused, logI_ns, sink_j)
mix_ll_nonet <- mixture_loglik_on_fused(beta_nonet, ptrav_nonet, w, logLgen, fused, logI_ns, sink_j)
KL_nonet_vs_full <- KL(r_nonet, r_full)
# Travel-history fit (optional readout; not used for genetics vs connectivity directly)
trav_ll_full <- travel_obj_on_fused(c(zU$z0, zU$zM, zU$zI, qlogis(zU$Se), qlogis(zU$Sp)),
H, fused, logI_ns)
trav_ll_nonet <- travel_obj_on_fused(c(zU_nonet$z0, 0, zU_nonet$zI, qlogis(zU_nonet$Se), qlogis(zU_nonet$Sp)),
H, fused, logI_ns)
# Genetics weight profile
w_prof <- profile_w(w_grid, beta, zeta, u, logMk_ns, logI_ns, logLgen, sink_j)
# Layer mixture (percentages)
alpha_hat <- softmax(u)
# Summaries
delta_mix_nogen <- mix_ll_full - mix_ll_nogen
delta_mix_nonet <- mix_ll_full - mix_ll_nonet
summary <- list(
layer_mixture_alpha = setNames(round(alpha_hat, 3), paste0("layer", seq_along(alpha_hat))),
genetics_weight_w   = w,
loglik = list(
mixture_full = mix_ll_full,
mixture_no_genetics = mix_ll_nogen,
mixture_no_connectivity = mix_ll_nonet,
delta_full_minus_no_genetics = delta_mix_nogen,
delta_full_minus_no_connectivity = delta_mix_nonet
),
KL_divergence = c(
KL_no_genetics_vs_full = KL_nogen_vs_full,
KL_no_connectivity_vs_full = KL_nonet_vs_full
),
travel_ll = c(full = trav_ll_full, no_connectivity = trav_ll_nonet)
)
list(summary = summary, w_profile = w_prof,
r_full = r_full, r_nogen = r_nogen, r_nonet = r_nonet)
}
## ============================
## Example: run diagnostics with your fitted objects
## ============================
diag <- importance_report(beta=beta, zeta=zeta, w=w, u=u,
logMk_ns=logMk_ns, logI_ns=logI_ns,
logLgen=logLgen, sink_j=sink_j, H=H)
# Print high-level summary
print(diag$summary)
# Quick plot of the w-profile (base R)
plot(diag$w_profile$w, diag$w_profile$mix_ll, type="l",
xlab="w (genetics weight)", ylab="Mixture log-likelihood",
main="Genetics weight profile")
# Optional: numerical summaries convenient for reporting
cat("\nΔLL full − no genetics:", round(diag$summary$loglik$delta_full_minus_no_genetics, 2),
"\nΔLL full − no connectivity:", round(diag$summary$loglik$delta_full_minus_no_connectivity, 2), "\n")
cat("KL(no genetics || full):", round(diag$summary$KL_divergence["KL_no_genetics_vs_full"], 4), "\n")
cat("KL(no connectivity || full):", round(diag$summary$KL_divergence["KL_no_connectivity_vs_full"], 4), "\n")
## ==========================================================
## EM fitter: CONNECTIVITY-ONLY (no genetics), multi-layer fusion
## ==========================================================
set.seed(123)
## ----- helpers -----
logsumexp <- function(x) { m <- max(x); m + log(sum(exp(x - m))) }
row_softmax_log <- function(L) {
N <- nrow(L); J <- ncol(L); R <- matrix(NA_real_, N, J)
for (n in 1:N) { ln <- L[n, ]; m <- max(ln); en <- exp(ln - m); R[n, ] <- en/sum(en) }
R
}
sigmoid <- function(x) 1/(1+exp(-x))
softmax <- function(v) { ev <- exp(v - max(v)); ev/sum(ev) }
zscore_offdiag <- function(M) {
J <- nrow(M); off <- M[row(M)!=col(M)]
mu <- mean(off); sdv <- sd(off); if (sdv==0) sdv <- 1
Z <- (M - mu)/sdv; diag(Z) <- 0; Z
}
## ==========================================================
## 1) Toy data with K layers (use your own if you have it)
## ==========================================================
J <- 5; N <- 400
coords <- cbind(runif(J), runif(J))
distmat <- as.matrix(dist(coords) + diag(1e-6, J))
pop <- round(runif(J, 3, 10)*1e5)
inc <- runif(J, 0.02, 0.12)
logInc_by_source <- matrix(rep(log(inc), each=J), nrow=J, byrow=FALSE)
# Three illustrative layers
rho1 <- 1.6; M1 <- outer(pop,pop)/(distmat^rho1); diag(M1) <- 0
rho2 <- 2.2; M2 <- outer(pop,pop)/(distmat^rho2); diag(M2) <- 0
thr <- quantile(distmat[row(distmat)!=col(distmat)], 0.35)
M3 <- (distmat<=thr)*outer(pop,pop)/(distmat^1.2); diag(M3) <- 0
logMks <- list(
zscore_offdiag(log(pmax(M1,1e-10))),
zscore_offdiag(log(pmax(M2,1e-10))),
zscore_offdiag(log(pmax(M3,1e-10)))
)
K <- length(logMks)
sink_j <- sample(1:J, N, replace=TRUE, prob=pop/sum(pop))
# Case–source matrices per layer: X_k[n,i] = logM_k[i, sink_j[n]]
logMk_ns <- lapply(logMks, function(Mk){
out <- matrix(NA_real_, N, J)
for (n in 1:N) out[n,] <- Mk[, sink_j[n]]
out
})
logI_ns <- logInc_by_source[sink_j,]
## Simulate travel history only (no genetics in this model)
# For nicer behavior in the toy, simulate with a fixed mixture (optional)
alpha_sim <- softmax(c(0.6, -0.1, -0.3))
fused_sim <- Reduce(`+`, Map(function(a,X) a*X, alpha_sim, logMk_ns))
z0_t <- -2.0; zM_t <- 1.0; zI_t <- 0.8
p_travel_true <- sigmoid(z0_t + zM_t*fused_sim + zI_t*logI_ns)
# Source-choice to generate a "true" src (only for toy evaluation)
bM_t <- 0.9; bI_t <- 1.0; bT_t <- 1.8; bLoc_t <- 0.8
eta_true <- bM_t*fused_sim + bI_t*logI_ns + bT_t*p_travel_true
for (n in 1:N) eta_true[n, sink_j[n]] <- eta_true[n, sink_j[n]] + bLoc_t
r_true <- row_softmax_log(eta_true)
true_src <- apply(r_true, 1, function(p) sample(1:J,1,prob=p))
# Travel misclassification (Se/Sp) to produce H
Se_true <- 0.75; Sp_true <- 0.85
H <- matrix(0L, N, J)
for (n in 1:N) for (i in 1:J) {
Z <- rbinom(1, 1, p_travel_true[n,i])
H[n,i] <- if (Z==1) rbinom(1,1,Se_true) else rbinom(1,1,1-(1-Sp_true))
}
## ==========================================================
## 2) Model: parameters & objectives (NO genetics)
## ==========================================================
pack_beta <- function(beta_M, beta_I, beta_T, beta_loc) c(beta_M, beta_I, beta_T, beta_loc)
unpack_beta <- function(b) list(beta_M=b[1], beta_I=b[2], beta_T=b[3], beta_loc=b[4])
pack_zeta <- function(z0, zM, zI, se_logit, sp_logit) c(z0, zM, zI, se_logit, sp_logit)
unpack_zeta <- function(z) list(z0=z[1], zM=z[2], zI=z[3],
Se=sigmoid(z[4]), Sp=sigmoid(z[5]))
fused_ns_from_u <- function(u, logMk_ns) {
alpha <- softmax(u)
Reduce(`+`, Map(function(a, X) a * X, alpha, logMk_ns))
}
# Gating objective on fused (no genetic term): sum_n [ r_n·η_n − logsumexp(η_n) ]
gating_obj_on_fused <- function(bvec, rmat, ptrav, fused, logI_ns, sink_j) {
b <- unpack_beta(bvec); N <- nrow(rmat); val <- 0
for (n in 1:N) {
eta <- b$beta_M*fused[n,] + b$beta_I*logI_ns[n,] + b$beta_T*ptrav[n,]
eta[sink_j[n]] <- eta[sink_j[n]] + b$beta_loc
val <- val + sum(rmat[n,]*eta) - logsumexp(eta)
}
val - 0.001*sum(bvec^2)  # small ridge
}
# Travel-history objective on fused (same as before)
travel_obj_on_fused <- function(zvec, H, fused, logI_ns) {
z <- unpack_zeta(zvec)
p <- sigmoid( z$z0 + z$zM*fused + z$zI*logI_ns )
q <- z$Se * p + (1 - z$Sp) * (1 - p)
q <- pmin(pmax(q, 1e-8), 1-1e-8)
sum(H*log(q) + (1-H)*log(1-q)) - 0.001*sum(zvec[1:3]^2)
}
# "Mixture" log-likelihood without genetics: sums of logsumexp(η_n)
loglik_on_fused <- function(beta_vec, ptrav, fused, logI_ns, sink_j) {
b <- unpack_beta(beta_vec); N <- nrow(fused); ll <- 0
for (n in 1:N) {
eta <- b$beta_M*fused[n,] + b$beta_I*logI_ns[n,] + b$beta_T*ptrav[n,]
eta[sink_j[n]] <- eta[sink_j[n]] + b$beta_loc
ll <- ll + logsumexp(eta)
}
ll
}
# Responsibilities (no genetics): softmax(η)
compute_resp_on_fused <- function(beta_vec, ptrav, fused, logI_ns, sink_j) {
b <- unpack_beta(beta_vec); N <- nrow(fused); J <- ncol(fused)
log_terms <- matrix(NA_real_, N, J)
for (n in 1:N) {
eta <- b$beta_M*fused[n,] + b$beta_I*logI_ns[n,] + b$beta_T*ptrav[n,]
eta[sink_j[n]] <- eta[sink_j[n]] + b$beta_loc
log_terms[n,] <- eta
}
row_softmax_log(log_terms)
}
## ==========================================================
## 3) EM fitting (optimize beta, zeta, and u; no w here)
## ==========================================================
beta <- pack_beta(0, 0, 0.5, 0.2)
zeta <- pack_zeta(-1.5, 0.5, 0.5, qlogis(0.7), qlogis(0.85))
u <- rep(0, K)  # α starts uniform
max_iter <- 120; tol <- 1e-4
history <- data.frame(iter=integer(), tot_ll=double(), trav_ll=double(),
a1=double(), a2=double(), a3=double())
for (iter in 1:max_iter) {
fused <- fused_ns_from_u(u, logMk_ns)
# E: latent travel propensity and implied report prob
zU <- unpack_zeta(zeta)
ptrav <- sigmoid( zU$z0 + zU$zM*fused + zU$zI*logI_ns )
qrep  <- zU$Se * ptrav + (1 - zU$Sp) * (1 - ptrav)
qrep  <- pmin(pmax(qrep, 1e-8), 1-1e-8)
# E: responsibilities over sources (no genetics)
r <- compute_resp_on_fused(beta, ptrav, fused, logI_ns, sink_j)
# M1: update gating beta
beta_new <- optim(beta, gating_obj_on_fused, rmat=r, ptrav=ptrav,
fused=fused, logI_ns=logI_ns, sink_j=sink_j,
control=list(fnscale=-1, maxit=500))$par
# M2: update zeta from travel history
zeta_new <- optim(zeta, travel_obj_on_fused, H=H, fused=fused, logI_ns=logI_ns,
control=list(fnscale=-1, maxit=500))$par
# M3: update u (layer mixture) — maximize total objective wrt u
obj_u <- function(u_try) {
fused_try <- fused_ns_from_u(u_try, logMk_ns)
ptrav_try <- sigmoid(unpack_zeta(zeta_new)$z0 +
unpack_zeta(zeta_new)$zM*fused_try +
unpack_zeta(zeta_new)$zI*logI_ns)
-( loglik_on_fused(beta_new, ptrav_try, fused_try, logI_ns, sink_j) +
travel_obj_on_fused(zeta_new, H, fused_try, logI_ns) ) +
1e-3 * sum(u_try^2)   # tiny L2 on u for stability
}
u_new <- optim(u, obj_u, control=list(maxit=400))$par
# Monitor
fused_new <- fused_ns_from_u(u_new, logMk_ns)
ptrav_new <- sigmoid(unpack_zeta(zeta_new)$z0 +
unpack_zeta(zeta_new)$zM*fused_new +
unpack_zeta(zeta_new)$zI*logI_ns)
tot_ll <- loglik_on_fused(beta_new, ptrav_new, fused_new, logI_ns, sink_j) +
travel_obj_on_fused(zeta_new, H, fused_new, logI_ns)
trav_ll <- travel_obj_on_fused(zeta_new, H, fused_new, logI_ns)
a_now <- softmax(u_new)
history <- rbind(history, data.frame(iter=iter, tot_ll=tot_ll, trav_ll=trav_ll,
a1=a_now[1], a2=a_now[2], a3=a_now[3]))
delta <- max(abs(c(beta_new - beta, zeta_new - zeta, u_new - u)))
beta <- beta_new; zeta <- zeta_new; u <- u_new
if (delta < tol) break
}
cat("Converged in", nrow(history), "iterations\n")
print(tail(history, 5))
alpha_hat <- softmax(u); names(alpha_hat) <- paste0("layer", 1:K)
cat("\nEstimated layer mixture (alpha):\n"); print(round(alpha_hat, 3))
## ==========================================================
## 4) Post-fit responsibilities, flows, connectivity
## ==========================================================
fused_hat <- fused_ns_from_u(u, logMk_ns)
z_hat <- unpack_zeta(zeta)
p_hat <- sigmoid( z_hat$z0 + z_hat$zM*fused_hat + z_hat$zI*logI_ns )
r_hat <- compute_resp_on_fused(beta, p_hat, fused_hat, logI_ns, sink_j)
F <- matrix(0, J, J)   # effective flows: F[i, j] = sum_n r_hat[n,i] for cases with sink j
for (n in 1:N) for (i in 1:J) F[i, sink_j[n]] <- F[i, sink_j[n]] + r_hat[n,i]
colnames(F) <- paste0("sink_", 1:J); rownames(F) <- paste0("src_", 1:J)
C <- sweep(F, 2, colSums(F), "/")  # column-normalized connectivity
cat("\nParameters:\n")
print(list(beta = unpack_beta(beta),
zeta = list(z0=z_hat$z0, zM=z_hat$zM, zI=z_hat$zI, Se=z_hat$Se, Sp=z_hat$Sp),
alpha = alpha_hat))
cat("\nFlow matrix F (src -> sink):\n"); print(round(F, 1))
cat("\nConnectivity index C (column-normalized):\n"); print(round(C, 3))
# (Optional) quick heatmaps
heat <- function(MAT, title="") {
op <- par(mar=c(4,4,2,1))
image(t(MAT[nrow(MAT):1, ]), axes=FALSE, col=terrain.colors(64), main=title)
axis(1, at=seq(0,1,length.out=ncol(MAT)), labels=colnames(MAT), las=2)
axis(2, at=seq(0,1,length.out=nrow(MAT)), labels=rev(rownames(MAT)), las=2)
box(); par(op)
}
heat(F, "Effective flows F (src->sink)")
heat(C, "Connectivity index C")
