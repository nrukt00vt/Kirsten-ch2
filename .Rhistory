## ----- helpers -----
logsumexp <- function(x) { m <- max(x); m + log(sum(exp(x - m))) }
row_softmax_log <- function(L) {
N <- nrow(L); J <- ncol(L); R <- matrix(NA_real_, N, J)
for (n in 1:N) { ln <- L[n, ]; m <- max(ln); en <- exp(ln - m); R[n, ] <- en/sum(en) }
R
}
sigmoid <- function(x) 1/(1+exp(-x))
softmax <- function(v) { ev <- exp(v - max(v)); ev/sum(ev) }
zscore_offdiag <- function(M) {
# z-score off-diagonal entries; leave diag ~ 0
J <- nrow(M); off <- M[row(M)!=col(M)]
mu <- mean(off); sdv <- sd(off); if (sdv==0) sdv <- 1
Z <- (M - mu)/sdv; diag(Z) <- 0; Z
}
## ==========================================================
## 1) Simulate toy data with K connectivity layers
## ==========================================================
J <- 5                       # provinces
N <- 400                    # cases
coords <- cbind(runif(J), runif(J))
distmat <- as.matrix(dist(coords)) + diag(1e-6, J)
pop <- round(runif(J, 3, 10) * 1e5)
inc <- runif(J, 0.02, 0.12)
logInc_by_source <- matrix(rep(log(inc), each = J), nrow = J, byrow = FALSE)
# Layer 1: "CDR-like" gravity with rho1
rho1 <- 1.6
M1 <- outer(pop, pop) / (distmat^rho1); diag(M1) <- 0
# Layer 2: "road-time" kernel (heavier short-range decay)
rho2 <- 2.2
M2 <- outer(pop, pop) / (distmat^rho2); diag(M2) <- 0
# Layer 3: "contiguity-ish" (neighbors if within quantile distance)
thr <- quantile(distmat[row(distmat)!=col(distmat)], 0.35)
M3 <- (distmat <= thr) * outer(pop, pop) / (distmat^1.2); diag(M3) <- 0
# Log & standardize (z-score) each layer for comparability
logM1 <- zscore_offdiag(log(pmax(M1, 1e-10)))
logM2 <- zscore_offdiag(log(pmax(M2, 1e-10)))
logM3 <- zscore_offdiag(log(pmax(M3, 1e-10)))
logMks <- list(logM1, logM2, logM3)
K <- length(logMks)
# Build case sinks
sink_j <- sample(1:J, N, replace = TRUE, prob = pop/sum(pop))
# Convenience: case-source matrices per layer: X_k[n,i] = logM_k[i, sink_j[n]]
logMk_ns <- lapply(logMks, function(Mk){
out <- matrix(NA_real_, N, J)
for (n in 1:N) out[n, ] <- Mk[, sink_j[n]]
out
})
## ----- True data generating process (unknown to the fitter) -----
# True mixture weights (the thing we want to LEARN): alpha_true
u_true <- c(0.6, -0.1, -0.3)                # logits; softmax -> ~percentages
alpha_true <- softmax(u_true)
# Fused logM used to simulate
fused_true_ns <- Reduce(`+`, Map(function(a, X) a*X, alpha_true, logMk_ns))
# Travel propensity (latent Z) uses fused network + incidence
zeta0_t <- -2.2; zetaM_t <- 0.9; zetaI_t <- 0.8
p_travel_true <- sigmoid(zeta0_t + zetaM_t*fused_true_ns + zetaI_t*logInc_by_source[sink_j,])
# Source choice (gating) uses fused + incidence + travel + local bias
betaM_t <- 0.8; betaI_t <- 1.0; betaT_t <- 2.0; betaLoc_t <- 0.8
eta_true <- betaM_t*fused_true_ns + betaI_t*logInc_by_source[sink_j,] + betaT_t*p_travel_true
for (n in 1:N) eta_true[n, sink_j[n]] <- eta_true[n, sink_j[n]] + betaLoc_t
r_true <- row_softmax_log(eta_true)
true_src <- apply(r_true, 1, function(p) sample(1:J, 1, prob = p))
# Genetics: higher log-lik for the true source
mu_hi <-  2.0; sd_hi <- 0.5
mu_lo <- -2.0; sd_lo <- 0.7
logLgen <- matrix(NA_real_, N, J)
for (n in 1:N) for (i in 1:J)
logLgen[n,i] <- if (i == true_src[n]) rnorm(1, mu_hi, sd_hi) else rnorm(1, mu_lo, sd_lo)
# Reported travel with misclassification (Se, Sp)
Se_true <- 0.75; Sp_true <- 0.85
H <- matrix(0L, N, J)
for (n in 1:N) {
for (i in 1:J) {
Z <- rbinom(1, 1, p_travel_true[n,i])
if (Z == 1) H[n,i] <- rbinom(1, 1, Se_true) else H[n,i] <- rbinom(1, 1, 1-(1-Sp_true))
}
}
# Incidence features per case-source
logI_ns <- logInc_by_source[sink_j, ]
pack_beta <- function(beta_M, beta_I, beta_T, beta_loc) c(beta_M, beta_I, beta_T, beta_loc)
unpack_beta <- function(b) list(beta_M=b[1], beta_I=b[2], beta_T=b[3], beta_loc=b[4])
pack_zeta <- function(z0, zM, zI, se_logit, sp_logit) c(z0, zM, zI, se_logit, sp_logit)
unpack_zeta <- function(z) list(z0=z[1], zM=z[2], zI=z[3],
Se=sigmoid(z[4]), Sp=sigmoid(z[5]))
# Fused NxJ matrix from logits u and layer matrices logMk_ns (list)
fused_ns_from_u <- function(u, logMk_ns) {
alpha <- softmax(u)
Reduce(`+`, Map(function(a, X) a * X, alpha, logMk_ns))
}
# Objectives now take 'fused' instead of single-layer logM_ns
gating_obj_on_fused <- function(bvec, rmat, ptrav, fused, logI_ns, sink_j) {
b <- unpack_beta(bvec); N <- nrow(rmat)
val <- 0
for (n in 1:N) {
eta <- b$beta_M*fused[n,] + b$beta_I*logI_ns[n,] + b$beta_T*ptrav[n,]
eta[sink_j[n]] <- eta[sink_j[n]] + b$beta_loc
val <- val + sum(rmat[n,]*eta) - logsumexp(eta)
}
val - 0.001*sum(bvec^2)  # small ridge
}
travel_obj_on_fused <- function(zvec, H, fused, logI_ns) {
z <- unpack_zeta(zvec)
p <- sigmoid( z$z0 + z$zM*fused + z$zI*logI_ns )          # latent travel propensity
q <- z$Se * p + (1 - z$Sp) * (1 - p)                      # P(H=1) after Se/Sp
q <- pmin(pmax(q, 1e-8), 1-1e-8)
sum(H*log(q) + (1-H)*log(1-q)) - 0.001*sum(zvec[1:3]^2)   # ridge on zetas only
}
mixture_loglik_on_fused <- function(beta_vec, ptrav, w, logLgen, fused, logI_ns, sink_j) {
b <- unpack_beta(beta_vec); N <- nrow(fused); ll <- 0
for (n in 1:N) {
eta <- b$beta_M*fused[n,] + b$beta_I*logI_ns[n,] + b$beta_T*ptrav[n,]
eta[sink_j[n]] <- eta[sink_j[n]] + b$beta_loc
log_terms <- eta + w*logLgen[n,]
ll <- ll + logsumexp(log_terms)
}
ll
}
compute_resp_on_fused <- function(beta_vec, ptrav, w, logLgen, fused, logI_ns, sink_j) {
b <- unpack_beta(beta_vec); N <- nrow(fused); J <- ncol(fused)
log_terms <- matrix(NA_real_, N, J)
for (n in 1:N) {
eta <- b$beta_M*fused[n,] + b$beta_I*logI_ns[n,] + b$beta_T*ptrav[n,]
eta[sink_j[n]] <- eta[sink_j[n]] + b$beta_loc
log_terms[n,] <- eta + w*logLgen[n,]
}
row_softmax_log(log_terms)
}
## ==========================================================
## 3) EM fitting (now also optimizes u, the mixture logits)
## ==========================================================
# Inits
beta <- pack_beta(0, 0, 0.5, 0.2)
zeta <- pack_zeta(-1.5, 0.5, 0.5, qlogis(0.7), qlogis(0.85))
w <- 1.0
u <- rep(0, K)   # equal alphas initially (softmax(0,...,0) = 1/K)
max_iter <- 120; tol <- 1e-4
history <- data.frame(iter=integer(), mix_ll=double(), trav_ll=double(), w=double(),
a1=double(), a2=double(), a3=double())
for (iter in 1:max_iter) {
# Fuse layers with current u (global mixture)
fused <- fused_ns_from_u(u, logMk_ns)
# E: travel propensity & reported-probabilities
z <- unpack_zeta(zeta)
ptrav <- sigmoid( z$z0 + z$zM*fused + z$zI*logI_ns )
qrep  <- z$Se * ptrav + (1 - z$Sp) * (1 - ptrav)
qrep  <- pmin(pmax(qrep, 1e-8), 1-1e-8)
# E: responsibilities over sources
r <- compute_resp_on_fused(beta, ptrav, w, logLgen, fused, logI_ns, sink_j)
# M1: update beta on fused
beta_new <- optim(beta, gating_obj_on_fused, rmat=r, ptrav=ptrav,
fused=fused, logI_ns=logI_ns, sink_j=sink_j,
control=list(fnscale=-1, maxit=500))$par
# M2: update zeta on fused
zeta_new <- optim(zeta, travel_obj_on_fused, H=H, fused=fused, logI_ns=logI_ns,
control=list(fnscale=-1, maxit=500))$par
# M3a: update genetics weight w (1-D)
obj_w <- function(w_try) {
- mixture_loglik_on_fused(beta_new,
ptrav=sigmoid(unpack_zeta(zeta_new)$z0 +
unpack_zeta(zeta_new)$zM*fused +
unpack_zeta(zeta_new)$zI*logI_ns),
w=w_try, logLgen=logLgen, fused=fused,
logI_ns=logI_ns, sink_j=sink_j) +
0.5*(w_try - 1)^2
}
w_new <- optimize(obj_w, interval=c(0.2, 3.0))$minimum
# M3b: update mixture logits u (thus alphas)
obj_u <- function(u_try) {
fused_try <- fused_ns_from_u(u_try, logMk_ns)
# negative (mixture LL + travel LL) + tiny L2 on u (stability)
- mixture_loglik_on_fused(beta_new,
ptrav=sigmoid(unpack_zeta(zeta_new)$z0 +
unpack_zeta(zeta_new)$zM*fused_try +
unpack_zeta(zeta_new)$zI*logI_ns),
w=w_new, logLgen=logLgen, fused=fused_try,
logI_ns=logI_ns, sink_j=sink_j)
- travel_obj_on_fused(zeta_new, H, fused_try, logI_ns) + 1e-3 * sum(u_try^2)
}
u_new <- optim(u, obj_u, control=list(maxit=400))$par
# Monitor
fused_new <- fused_ns_from_u(u_new, logMk_ns)
mix_ll <- mixture_loglik_on_fused(beta_new,
ptrav=sigmoid(unpack_zeta(zeta_new)$z0 +
unpack_zeta(zeta_new)$zM*fused_new +
unpack_zeta(zeta_new)$zI*logI_ns),
w=w_new, logLgen=logLgen, fused=fused_new,
logI_ns=logI_ns, sink_j=sink_j)
trav_ll <- travel_obj_on_fused(zeta_new, H, fused_new, logI_ns)
alpha_now <- softmax(u_new)
history <- rbind(history, data.frame(iter=iter, mix_ll=mix_ll, trav_ll=trav_ll, w=w_new,
a1=alpha_now[1], a2=alpha_now[2], a3=alpha_now[3]))
# Convergence & accept
delta <- max(abs(c(beta_new - beta, zeta_new - zeta, w_new - w, u_new - u)))
beta <- beta_new; zeta <- zeta_new; w <- w_new; u <- u_new
if (delta < tol) break
}
cat("Converged in", nrow(history), "iterations\n")
print(tail(history, 5))
