#Load package to solve the system of differential equations.
require(deSolve)
# Function describing the SIIII model equations.
siiii <- function(t,x,parms){
S <- x[1]
I1 <- x[2]
I2 <- x[3]
I3<- x[4]
I4<- x[5]
I<-I1+I2+I3+I4
N<-S+I
# Lambda and mu are included in the ODE system as they do not change
lambda<-100
mu=1/70
with(as.list(parms),
{
dS <- lambda-((beta*exp(-alpha*I/N)*I)/N)*S-mu*S
dI1 <- ((beta*exp(-alpha*I/N)*I)/N)*S - (gamma+mu)*I1
dI2 <- gamma*I1- (gamma+mu)*I2
dI3<-gamma*I2- (gamma+mu)*I3
dI4<-gamma*I3- (gamma+mu)*I4
res <- c(dS,dI1,dI2,dI3,dI4)
list(res)
})
}
# Data set
Prevalence<-c(7.3, 9.2, 11.3, 13.5, 15.9, 18.3, 20.6, 22.7, 24.6, 26.3, 27.8, 29, 30, 30.8, 31.4, 31.9, 32.4, 32.8, 33.4, 33.3, 34, 34)
# Initial guesses
alpha0<-200
beta0<-0.1
gamma0<-0.1
# Initial conditions
InitialConditions <- c(6992, 7.3, 0, 0, 0)
# Time span for optimization
time <-  seq(1,22,1)
# This is a function calculates the sum of squares between the data and model output.
ss <- function(alpha, beta, gamma, data = Prevalence) {
time <-  time
x0 <- c(6992, 7.3, 0, 0, 0)
Parameters <-c(alpha=alpha, beta=beta, gamma=gamma)
out<- ode(y=x0, time, siiii, Parameters)
sum( ((out[1:length(data),3]+ out[1:length(data),4]+out[1:length(data),5] + out[1:length(data),6]) - data )^2 )
}
#This is the function that we are trying to minimize to find the best parameter values.
ss2 <- function(k) {
ss(alpha=k[1], beta=k[2], gamma=k[3])
}
