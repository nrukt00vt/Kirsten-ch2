sir <- function(t,x,parms){
S <- x[1]
E <- x[2]
I <- x[3]
R <- x[4]
with(as.list(parms),
{
dS <- -beta*S*I
dE <- beta*S*I - alpha*E
dI <- alpha*E - gamma*I
dR <- gamma*I
res <- c(dS,dE,dI,dR)
list(res)
})
}
