I1 <- x[2]
I2 <- x[3]
I3 <- x[4]
I4 <- x[5]
I <- x[6]
N <- x[7]
L <- x[8]
with(as.list(parms),
{
dS <- 100 - (L*S) - ((1/70)*S)
dI1 <- (L*S) - (gamma + (1/70))*I1
dI2 <- gamma*I1 - (gamma + (1/70))*I2
dI3 <- gamma*I2 - (gamma + (1/70))*I3
dI4 <- gamma*I3 - (gamma + (1/70))*I4
dI <- dI1 + dI2 + dI3 + dI4
dN <- dS + dI
dL <- (beta* exp((-alpha*I)/N)*I)/N
res <- c(dS,dI1,dI2,dI3,dI4,dI,dN,dL)
list(res)
})
}
#Initial Conditions
#per million
S0 = 6992
I10 = 7.3
N0 = S0 + I10
L0 = ((0.1*exp((-200*I10)/N0))*I10)/N0
#(S,I1,I2,I3,I4,I,N,L)
initial_conditions_q1 = c(S0, I10, 0, 0, 0, I10, N0,L0)
#time span
time <- seq(1990,2011,1)
#Vector with data points from table
#data in millions
HIV_cases = c(7.3, 9.2, 11.3, 13.5, 15.9, 18.3, 20.6, 22.7, 24.6, 26.3, 27.8, 29, 30, 30.8, 31.4, 31.9, 32.4, 32.8, 33.4, 33.3, 34, 34)
# This is a function calculates the sum of squares between the data and model output.
ss <- function(alpha, beta,  gamma, data = HIV_cases) {
S0 <- 6992
I0 <- 7.3
N0 = S0 + I10
L0 = ((0.1*exp((-200*I0)/N0))*I0)/N0
timespan <- time
x0<-c(S0, I0, 0, 0, 0, I0, N0, L0)
Parameters <- c(alpha=alpha, beta=beta, gamma=gamma)
out<- ode(y=x0, timespan, sir, Parameters,  method = "lsoda")
sum( (out[1:length(data),6] - data)^2 )
}
# This is the function that we are trying to minimize to find the best parameter values.
ss2 <- function(k) {
ss(alpha=k[1], beta=k[2], gamma=k[3])
}
# Here, we are inputting our initial guess for the values of alpha, beta, and gamma
starting_param_val <- c(1, 0.1, 0.1)
# Optim is R's function that performs the optimization algorithm. lower tells the algorithm to only look at parameter values that are greater than or equal to 0.
ss_optim <- optim(starting_param_val, ss2,  method="L-BFGS-B", lower = c(0, 0, 0))
# Calls the results from the optimization procedure.
ss_optim
Fitted_params<-c(alpha=ss_optim$par[1], beta=ss_optim$par[2], gamma=ss_optim$par[3])
# Time span for plotting
tspan<- seq(1990,2011,1)
stateMatrix <- ode(y=initial_conditions_q1, tspan, sir, Fitted_params)
