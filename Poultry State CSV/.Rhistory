N <- S + I
with(as.list(parms),
{
dS <- 100 - (((beta*exp(-alpha*I/N)*I)/N)*S) - ((1/70)*S)
dI1 <- (((beta*exp(-alpha*I/N)*I)/N)*S) - (gamma + (1/70))*I1
dI2 <- gamma*I1 - (gamma + (1/70))*I2
dI3 <- gamma*I2 - (gamma + (1/70))*I3
dI4 <- gamma*I3 - (gamma + (1/70))*I4
dI <- dI1 + dI2 + dI3 + dI4
res <- c(dS,dI1,dI2,dI3,dI4)
list(res)
})
}
